{
  "name": "outfit-tools",
  "account_id": "404dbf11482c2c37e173fabe424aa664",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "johnhenning.dev/tools/dotfiles*",
      "zone_name": "johnhenning.dev"
    },
    {
      "pattern": "getoutfit.dev",
      "custom_domain": true
    },
    {
      "pattern": "johnhenning.dev/tools/outfit",
      "zone_name": "johnhenning.dev"
    },
    {
      "pattern": "johnhenning.dev/tools/outfit/*",
      "zone_name": "johnhenning.dev"
    }
  ]
}
